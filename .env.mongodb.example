# MongoDB client settings for the Leaderboard collector. .NET does not load this
# file automatically; inject these values through a Secret or ConfigMap.
# Replace every REPLACE_* value. URL-encode the password in the connection URI.
# Majority write concern requires an explicit replicaSet in the URI. For a
# standalone server, use Journaled instead and adapt the URI accordingly.
MongoArchive__ConnectionString=mongodb://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_MONGODB_HOST:27017/leaderboard_datalake?authSource=REPLACE_AUTH_DATABASE&replicaSet=REPLACE_REPLICA_SET&tls=true
MongoArchive__Database=leaderboard_datalake
MongoArchive__Collection=raw_events
MongoArchive__WriteConcern=Majority
