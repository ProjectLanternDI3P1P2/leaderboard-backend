# Inject through environment/Secrets; .NET does not load this file automatically.
# Majority + journal requires a replica set. URL-encode the password.
ConnectionStrings__Mongo=mongodb://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_MONGODB_HOST:27017/?authSource=REPLACE_AUTH_DATABASE&replicaSet=REPLACE_REPLICA_SET&tls=true
Mongo__DatabaseName=progression_lake
Mongo__CollectionName=raw_events
