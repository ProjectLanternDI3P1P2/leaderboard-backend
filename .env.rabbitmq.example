# Client settings for the Leaderboard collector. .NET does not load this file
# automatically; inject these values through a Secret or ConfigMap.
# Replace REPLACE_LEADERBOARD_USER and REPLACE_WITH_SECRET with deployment values.
# The collector declares its queue/exchange topology at startup. AMQP currently
# uses no TLS setting in the application.
RabbitMq__Enabled=true
RabbitMq__HostName=rabbitmq.rabbitmq.svc.cluster.local
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__UserName=REPLACE_LEADERBOARD_USER
RabbitMq__Password=REPLACE_WITH_SECRET
RabbitMq__QueueName=leaderboard.collection.v1
RabbitMq__DeadLetterExchangeName=leaderboard.collection.dead-letter
RabbitMq__DeadLetterQueueName=leaderboard.collection.v1.dead
RabbitMq__PrefetchCount=64
RabbitMq__RetryDelaySeconds=5
RabbitMq__MaxDeliveryAttempts=10
RabbitMq__ReconnectDelaySeconds=5
