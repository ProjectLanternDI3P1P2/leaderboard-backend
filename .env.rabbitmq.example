# Inject through environment/Secrets; .NET does not load this file automatically.
# The consumer binds the five producer exchanges defined by the contract.
RabbitMq__Enabled=true
RabbitMq__HostName=rabbitmq.rabbitmq.svc.cluster.local
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__UserName=REPLACE_LEADERBOARD_USER
RabbitMq__Password=REPLACE_WITH_SECRET
RawEventConsumer__Enabled=true
RawEventConsumer__QueueName=leaderboard.raw-events
RawEventConsumer__DeadLetterQueueName=leaderboard.raw-events.dead
RawEventConsumer__BatchSize=100
RawEventConsumer__BatchTimeout=00:00:00.500
RawEventConsumer__MaxAttempts=5
RawEventConsumer__InitialBackoff=00:00:00.500
RawEventConsumer__ReconnectDelay=00:00:05
