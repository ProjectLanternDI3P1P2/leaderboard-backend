<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/ProjectLanternDI3P1P2/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="github">
      <package pattern="Player.Contracts" />
      <package pattern="Dungeon.Contracts" />
      <package pattern="Combat.Contracts" />
      <package pattern="Reward.Contracts" />
      <package pattern="Leaderboard.Contracts" />
    </packageSource>
  </packageSourceMapping>
</configuration>
