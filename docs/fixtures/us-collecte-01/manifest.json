  "binaryGeneration": "GameEventEnvelope.Parser.ParseJson(json).ToByteArray() using this repository generated types",
  "rawHandling": "Preserve the complete original AMQP body without reserialization, including invalid or unknown messages. Parse status is metadata only. If normal archival cannot accept a body, use durable quarantine before acknowledging.",
  "publication": "Persist business change and serialized event in the same local transaction/outbox. Publish after commit with broker confirms and unroutable handling. Retry the same bytes and messageId; transactionId may be shared by distinct events.",
  "excludedFacts": [
    "Rejected skill commands emit no skill-used event.",
    "Connection loss/reconnection emits no lobby leave/join fact.",
    "Hero selection, equipment removal, gold spending and chest opening are deferred extensions."
