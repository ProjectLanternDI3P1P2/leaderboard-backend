{
    "Kestrel":  {
                    "Endpoints":  {
                                      "Http":  {
                                                   "Url":  "http://+:8080",
                                                   "Protocols":  "Http1"
                                               }
                                  }
                },
    "Serilog":  {
                    "Using":  [
                                  "Serilog.Expressions"
                              ],
                    "Filter":  [
                                   {
                                       "Name":  "ByExcluding",
                                       "Args":  {
                                                    "expression":  "RequestPath like \u0027%/health%\u0027 and (StatusCode is null or StatusCode = 200) or (RequestPath like \u0027%/metrics%\u0027 and (StatusCode is null or StatusCode = 200))"
                                                }
                                   }
                               ],
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft":  "Information",
                                                          "Microsoft.Hosting.Lifetime":  "Information",
                                                          "Microsoft.EntityFrameworkCore":  "Information",
                                                          "Microsoft.EntityFrameworkCore.Database.Command":  "Information"
                                                      }
                                     },
                    "Enrich":  [
                                   "FromLogContext",
                                   "WithMachineName"
                               ],
                    "WriteTo":  [
                                    {
                                        "Name":  "Console",
                                        "Args":  {
                                                     "theme":  "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                                                     "outputTemplate":  "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level}] {Scope} {Message:lj} \u003cs:{SourceContext}\u003e [level:{level}]{NewLine}{Exception}"
                                                 }
                                    }
                                ]
                },
    "AllowedHosts":  "*",
    "RabbitMq":  {
                     "Enabled":  false,
                     "HostName":  "localhost",
                     "Port":  5672,
                     "VirtualHost":  "/",
                     "UserName":  "guest",
                     "Password":  "guest",
                     "QueueName":  "leaderboard.collection.v1",
                     "DeadLetterExchangeName":  "leaderboard.collection.dead-letter",
                     "DeadLetterQueueName":  "leaderboard.collection.v1.dead",
                     "PrefetchCount":  64,
                     "RetryDelaySeconds":  5,
                     "MaxDeliveryAttempts":  10,
                     "ReconnectDelaySeconds":  5
                 },
    "MongoArchive":  {
                         "ConnectionString":  "mongodb://localhost:27017",
                         "Database":  "leaderboard_datalake",
                         "Collection":  "raw_events",
                         "WriteConcern":  "Journaled"
                     }
}
