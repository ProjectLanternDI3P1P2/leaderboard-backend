{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/health%' and (StatusCode is null or StatusCode = 200) or (RequestPath like '%/metrics%' and (StatusCode is null or StatusCode = 200))"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level}] {Scope} {Message:lj} <s:{SourceContext}> [level:{level}]{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "ConnectionStrings": {
    "Mongo": "mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"
  },
  "Mongo": {
    "DatabaseName": "progression_lake",
    "CollectionName": "raw_events"
  },
  "RawEventConsumer": {
    "Enabled": false,
    "QueueName": "leaderboard.raw-events",
    "DeadLetterQueueName": "leaderboard.raw-events.dead",
    "BatchSize": 100,
    "BatchTimeout": "00:00:00.500",
    "MaxAttempts": 5,
    "InitialBackoff": "00:00:00.500",
    "ReconnectDelay": "00:00:05"
  }
}
