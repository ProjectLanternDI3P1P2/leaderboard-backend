{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Expressions"
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "RequestPath like '%/health%' and (StatusCode is null or StatusCode = 200) or (RequestPath like '%/metrics%' and (StatusCode is null or StatusCode = 200))"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level}] {Scope} {Message:lj} <s:{SourceContext}> [level:{level}]{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RawEventConsumer": {
    "SourceExchanges": [
      "player.events",
      "dungeon.events",
      "combat.events",
      "rewards.events"
    ]
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "progression.events",
    "QueueName": "progression.events.v1",
    "PrefetchCount": 16,
    "DeadLetterExchangeName": "lantern.dead-letter",
    "DeadLetterQueueName": "progression.events.v1.dead",
    "Subscriptions": [
      {
        "ExchangeName": "player.events",
        "RoutingKey": "player.game-session-started.v1"
      },
      {
        "ExchangeName": "player.events",
        "RoutingKey": "player.game-session-ended.v1"
      },
      {
        "ExchangeName": "player.events",
        "RoutingKey": "player.hero-created.v1"
      },
      {
        "ExchangeName": "player.events",
        "RoutingKey": "player.game-session-member-joined.v1"
      },
      {
        "ExchangeName": "dungeon.events",
        "RoutingKey": "dungeon.dungeon-run-started.v1"
      },
      {
        "ExchangeName": "dungeon.events",
        "RoutingKey": "dungeon.room-entered.v1"
      },
      {
        "ExchangeName": "dungeon.events",
        "RoutingKey": "dungeon.chest-opened.v1"
      },
      {
        "ExchangeName": "dungeon.events",
        "RoutingKey": "dungeon.dungeon-run-ended.v1"
      },
      {
        "ExchangeName": "combat.events",
        "RoutingKey": "combat.combat-started.v1"
      },
      {
        "ExchangeName": "combat.events",
        "RoutingKey": "combat.action-resolved.v1"
      },
      {
        "ExchangeName": "combat.events",
        "RoutingKey": "combat.combat-completed.v1"
      },
      {
        "ExchangeName": "rewards.events",
        "RoutingKey": "rewards.reward-granted.v1"
      },
      {
        "ExchangeName": "rewards.events",
        "RoutingKey": "rewards.inventory-item-consumed.v1"
      },
      {
        "ExchangeName": "rewards.events",
        "RoutingKey": "rewards.equipment-changed.v1"
      },
      {
        "ExchangeName": "rewards.events",
        "RoutingKey": "rewards.purchase-completed.v1"
      }
    ]
  }
}
