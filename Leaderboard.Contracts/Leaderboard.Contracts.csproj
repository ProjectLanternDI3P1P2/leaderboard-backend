<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Leaderboard.Contracts</PackageId>
    <Description>Shared Protobuf contracts for Leaderboard integration events.</Description>
    <PackageTags>grpc;protobuf;rabbitmq;events;contracts</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.2" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/leaderboard_events_v1.proto" GrpcServices="None" />
    <None Include="Protos/leaderboard_events_v1.proto" Pack="true" PackagePath="proto" />
  </ItemGroup>

</Project>
